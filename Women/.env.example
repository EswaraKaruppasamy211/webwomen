# ==============================================================================
# SafeHer AI - Environment Variables Configuration Template
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET=safeher_super_secure_production_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Optional PostgreSQL Database URL (Leave empty for instant SQLite zero-friction mode)
DATABASE_URL=

# Maps & Navigation Provider Keys (Optional: Leaflet/OSM used by default out of the box)
MAPS_API_KEY=

# Pluggable AI Engine Key (Optional: Smart fallback rule engine active by default)
AI_API_KEY=

# Emergency SMS & Email Gateways (Optional: Verified delivery simulator active by default)
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=

# Default Administrator Credentials for initial seed
ADMIN_DEFAULT_EMAIL=admin@safeher.ai
ADMIN_DEFAULT_PASSWORD=Admin@SafeHer2026!
